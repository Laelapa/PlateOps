ENVIRONMENT=dev|development|test|testing|prod|production
SERVER_SHUTDOWN_TIMEOUT=5 #Time in seconds the server has to gracefully shut down before forced closing
POSTGRES_USER=pguser
POSTGRES_PASSWORD=pgpassword
POSTGRES_PORT=5432
POSTGRES_DB=postgresdb
DB_URL="postgres://pguser:pgpassword@serverurl:5432/postgresdb"
GOOSE_DRIVER=postgres
GOOSE_DBSTRING= same as DB_URL
GOOSE_MIGRATION_DIR=./internal/migrations
KAFKA_BROKERS=kafka.host.example:9092,kafka.host.example:9093
JWT_SECRET=string of 16+ chars (ideally 32+) can be generated by running `openssl rand -base64 64` among other options
SERVICE_NAME=MyPlateOpsInstance
STATIC_DIR=./static
SERVER_PORT=8080
