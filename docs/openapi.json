{
  "openapi": "3.1.0",
  "info": {
    "title": "PlateOps API",
    "version": "0.0.0-dev",
    "description": "Food management and nutrition API"
  },
  "servers": [
    {
      "url": "https://plateops.fly.dev",
      "description": "Server under iterative development"
    },
    {
      "url": "http://localhost:8081",
      "description": "Test environment server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "SignupRequest": {
        "type": "object",
        "required": ["username", "email", "password"],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 5,
            "maxLength": 24
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72
          }
        }
      },
      "SignupResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "user_id": { "type": "string", "format": "uuid" },
          "jwt": { "type": "string" },
          "refresh_token": { "type": "string" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "user_id": { "type": "string", "format": "uuid" },
          "jwt": { "type": "string" },
          "refresh_token": { "type": "string" }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refresh_token", "user_id"],
        "properties": {
          "refresh_token": { "type": "string" },
          "user_id": { "type": "string", "format": "uuid" }
        }
      },
      "RefreshResponse": {
        "type": "object",
        "properties": {
          "jwt": { "type": "string" }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "required": ["refresh_token"],
        "properties": {
          "refresh_token": { "type": "string" }
        }
      },
      "LogoutResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" }
        }
      },
      "CreateFoodRequest": {
        "type": "object",
        "required": ["name", "unit_type", "quantity"],
        "properties": {
          "name": { "type": "string", "maxLength": 255 },
          "gtin": { 
            "type": "string", 
            "pattern": "^[0-9]{8,14}$", 
            "maxLength": 14 
          },
          "category": { "type": "string", "maxLength": 255 },
          "description": { "type": "string", "maxLength": 5000 },
          "unit_type": {
            "type": "string",
            "enum": ["items", "grams", "ml", "portions"]
          },
          "quantity": { "type": "integer", "minimum": 1 },
          "portion_count": { "type": "integer", "minimum": 1 },
          "expiration_after_opening": { "type": "integer", "minimum": 0 },
          "nutrients_per_item": { "type": "boolean" },
          "calories": { "type": "number", "minimum": 0 },
          "fats": { "type": "number", "minimum": 0 },
          "saturated": { "type": "number", "minimum": 0 },
          "carbs": { "type": "number", "minimum": 0 },
          "sugars": { "type": "number", "minimum": 0 },
          "protein": { "type": "number", "minimum": 0 },
          "fiber": { "type": "number", "minimum": 0 },
          "sodium": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      },
      "CreateFoodResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "product_id": { "type": "integer" }
        }
      },
      "UpdateFoodRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "maxLength": 255 },
          "gtin": { 
            "type": "string", 
            "pattern": "^[0-9]{8,14}$", 
            "maxLength": 14 
          },
          "category": { "type": "string", "maxLength": 255 },
          "description": { "type": "string", "maxLength": 5000 },
          "unit_type": {
            "type": "string",
            "enum": ["items", "grams", "ml", "portions"]
          },
          "quantity": { "type": "integer", "minimum": 1 },
          "portion_count": { "type": "integer", "minimum": 1 },
          "expiration_after_opening": { "type": "integer", "minimum": 0 },
          "nutrients_per_item": { "type": "boolean" },
          "calories": { "type": "number", "minimum": 0 },
          "fats": { "type": "number", "minimum": 0 },
          "saturated": { "type": "number", "minimum": 0 },
          "carbs": { "type": "number", "minimum": 0 },
          "sugars": { "type": "number", "minimum": 0 },
          "protein": { "type": "number", "minimum": 0 },
          "fiber": { "type": "number", "minimum": 0 },
          "sodium": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false,
        "example": {
          "name": "Organic Apple",
          "category": "Fruits",
          "calories": 95,
          "carbs": 25
        }
      },
      "UpdateFoodResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "product_id": { "type": "integer" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "FoodDetailResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string", "nullable": true },
          "gtin": { 
            "type": "string", 
            "pattern": "^[0-9]{8,14}$", 
            "nullable": true 
          },
          "category": { "type": "string", "nullable": true },
          "description": { "type": "string", "nullable": true },
          "unit_type": { "type": "string", "nullable": true },
          "quantity": { "type": "integer", "nullable": true },
          "portion_count": { "type": "integer", "nullable": true },
          "expiration_after_opening": { "type": "integer", "nullable": true },
          "nutrients_per_item": { "type": "boolean", "nullable": true },
          "calories": { "type": "number", "nullable": true },
          "fats": { "type": "number", "nullable": true },
          "saturated": { "type": "number", "nullable": true },
          "carbs": { "type": "number", "nullable": true },
          "sugars": { "type": "number", "nullable": true },
          "protein": { "type": "number", "nullable": true },
          "fiber": { "type": "number", "nullable": true },
          "sodium": { "type": "number", "nullable": true }
        },
        "example": {
          "id": 5827,
          "name": "Apple",
          "gtin": null,
          "category": "Fruits",
          "description": null,
          "unit_type": "items",
          "quantity": 1,
          "portion_count": null,
          "expiration_after_opening": null,
          "nutrients_per_item": true,
          "calories": 95.0,
          "fats": null,
          "saturated": null,
          "carbs": 25.0,
          "sugars": 19.0,
          "protein": 0.5,
          "fiber": null,
          "sodium": null
        }
      }
    }
  },
  "security": [
    { "BearerAuth": [] }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/signup": {
      "post": {
        "summary": "User registration",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SignupRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SignupResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "Username/email taken",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "User login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/refresh": {
      "post": {
        "summary": "Refresh JWT token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token refreshed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RefreshResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid refresh token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/logout": {
      "post": {
        "summary": "User logout",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LogoutRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logout successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LogoutResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/food": {
      "post": {
        "summary": "Create food entry",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateFoodRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Food created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreateFoodResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "Food name exists",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        },
        "tags": ["Food Registry"]
      }
    },
    "/food/id/{id}": {
      "get": {
        "summary": "Get food entry by ID",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Product ID of the food entry to retrieve"
          }
        ],
        "responses": {
          "200": {
            "description": "Food entry retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FoodDetailResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid product ID",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Food entry not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        },
        "tags": ["Food Registry"]
      },
      "patch": {
        "summary": "Update food entry",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Product ID of the food entry to update"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateFoodRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Food updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UpdateFoodResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid input or product ID",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Food entry not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "GTIN already exists for another food entry",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        },
        "tags": ["Food Registry"]
      }
    },
    "/food/gtin/{gtin}": {
      "get": {
        "summary": "Get food entry by GTIN",
        "security": [],
        "parameters": [
          {
            "name": "gtin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{1,14}$"
            },
            "description": "Product GTIN of the food entry to retrieve"
          }
        ],
        "responses": {
          "200": {
            "description": "Food entry retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FoodDetailResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid product GTIN",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Food entry not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        },
        "tags": ["Food Registry"]
      }
    },
    "/foods/name/{name}": {
      "get": {
        "summary": "Search food entries by name (partial matching)",
        "description": "Search for food entries where the name contains the search term. Uses fuzzy matching to find partial matches and handle typos.",
        "security": [],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 255,
              "minLength": 1
            },
            "description": "Search term to find in food names. Supports partial matching (e.g., 'apple' finds 'Apple Juice', 'Pineapple')",
            "example": "apple"
          }
        ],
        "responses": {
          "200": {
            "description": "Food entries found successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "foods": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/FoodDetailResponse"
                      }
                    },
                    "count": {
                      "type": "integer",
                      "description": "Number of food entries found"
                    }
                  },
                  "example": {
                    "foods": [
                      {
                        "id": 1,
                        "name": "Apple",
                        "gtin": "1234567890123",
                        "category": "Fruits",
                        "description": "Fresh red apple",
                        "unit_type": "items",
                        "quantity": 1,
                        "portion_count": 1,
                        "expiration_after_opening": null,
                        "nutrients_per_item": true,
                        "calories": 95.0,
                        "fats": 0.3,
                        "saturated": 0.1,
                        "carbs": 25.0,
                        "sugars": 19.0,
                        "protein": 0.5,
                        "fiber": 4.0,
                        "sodium": 2.0
                      },
                      {
                        "id": 15,
                        "name": "Apple Juice",
                        "gtin": "9876543210987",
                        "category": "Beverages",
                        "description": "100% pure apple juice",
                        "unit_type": "ml",
                        "quantity": 1000,
                        "portion_count": 4,
                        "expiration_after_opening": 3,
                        "nutrients_per_item": false,
                        "calories": 46.0,
                        "fats": 0.1,
                        "saturated": 0.0,
                        "carbs": 11.0,
                        "sugars": 10.0,
                        "protein": 0.1,
                        "fiber": 0.2,
                        "sodium": 4.0
                      }
                    ],
                    "count": 2
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid search term",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "empty_name": {
                    "summary": "Empty search term",
                    "value": {
                      "error": "Invalid food name",
                      "message": "Search term cannot be empty"
                    }
                  },
                  "name_too_long": {
                    "summary": "Search term too long",
                    "value": {
                      "error": "Invalid food name",
                      "message": "Search term cannot exceed 255 characters"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": ["Food Registry"]
      }
    }
  }
}